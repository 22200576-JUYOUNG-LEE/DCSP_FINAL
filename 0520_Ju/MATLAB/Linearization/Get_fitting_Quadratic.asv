function [coeff_pos, coeff_neg, coeff_dz, pos_start, neg_start] = Get_fitting_Quadratic(Vc, Wgyro, order)

    % =========================================================
    % parameters
    % =========================================================
    pos_start = 64.87;    % (CW) DZ_START [deg/s]
    pos_end   = 941.97;   % (CW) SAT_END [deg/s]

    neg_start = -67.2453; % (CCW) DZ_START [deg/s]
    neg_end   = -905.685; % (CCW) SAT_END [deg/s]

    dz_order  = 3;        % DEADZONE FITTING 

    % (Operating Point) 
    OperPoint_Vcmd = pos_start;
    [~, OperPoint_idx] = min(abs(Wgyro - OperPoint_Vcmd));
    OperPoint_Vc = Vc(OperPoint_idx);

    % =========================================================
    % (Region Selection)
    % =========================================================
    pos_region = (Wgyro >= pos_start) & (Wgyro <= pos_end);
    neg_region = (Wgyro >= neg_end) & (Wgyro <= neg_start);
    dz_region  = (Wgyro < pos_start) & (Wgyro > neg_start); 

    % =========================================================
    % (Polynomial Fitting)
    % =========================================================
    % 1. CW & CCW FITTING WITH GIVEN ORDER
    coeff_pos = polyfit(Wgyro(pos_region), Vc(pos_region), order);
    coeff_neg = polyfit(Wgyro(neg_region), Vc(neg_region), order);

    % 2. DEADZONE FITTING with 3rd ORDER
    coeff_dz  = polyfit(Wgyro(dz_region), Vc(dz_region), dz_order); 

    % =========================================================
    % (LIN_COEF.csv)
    % =========================================================
    % NAN PEDDING 
    coeff_dz_data = nan(1, length(coeff_pos)); 
    coeff_dz_data(1:length(coeff_dz)) = coeff_dz;
    
    header_row = nan(1, length(coeff_pos));
    header_row(1:2) = [OperPoint_Vcmd, OperPoint_Vc];

    data_matrix = [header_row; coeff_pos; coeff_neg; coeff_dz_data];
    writematrix(data_matrix, '..\data\LIN_COEF.csv'); 

    % =========================================================
    % (Plot)
    % =========================================================
    figure(); hold on; grid on; box on;

    plot(Wgyro, Vc, 'b.', 'LineWidth', 1.5, 'DisplayName', 'Dataset');
    plot(Wgyro(pos_region), polyval(coeff_pos, Wgyro(pos_region)), 'r-', 'LineWidth', 2, 'DisplayName', 'Positive Fit');
    plot(Wgyro(neg_region), polyval(coeff_neg, Wgyro(neg_region)), 'm-', 'LineWidth', 2, 'DisplayName', 'Negative Fit');
    plot(Wgyro(dz_region), polyval(coeff_dz, Wgyro(dz_region)), 'g-', 'LineWidth', 2, 'DisplayName', 'Deadzone Fit (3rd)');

    xlabel('\omega_{gyro} [deg/s]', 'FontWeight', 'bold');
    ylabel('V_c [V]', 'FontWeight', 'bold');
    legend('Location', 'best');

end